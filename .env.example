# ========================================================
# THE ANGAAR LABS — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.local for local development. Never commit .env!
# ========================================================

# Application Environment & Base URL
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database Connection (MongoDB Atlas or Local Instance)
# Example: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/angaar_labs?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/angaar_labs

# Authentication (Admin CMS)
# Generate a secure 32+ character string using `openssl rand -hex 32`
JWT_SECRET=super_secret_jwt_key_for_angaar_labs_admin_auth_2026
ADMIN_EMAIL=admin@angaarlabs.com
ADMIN_PASSWORD=AngaarSuperAdmin2026!
ADMIN_NAME="Angaar Director"

# Email Delivery Integration (Resend / Nodemailer)
# Provide API key or SMTP credentials when configured
RESEND_API_KEY=re_sample_key_replace_with_real_token
CONTACT_NOTIFICATION_EMAIL=hello@angaarlabs.com
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
FROM_EMAIL=notifications@angaarlabs.com

# Media & Storage (Cloudinary - Optional for dynamic uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
